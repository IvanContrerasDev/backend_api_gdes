# Database
DATABASE_URL=postgresql://gdes:gdes@localhost:5432/gdes

# JWT
JWT_ACCESS_SECRET=change-access-secret
JWT_REFRESH_SECRET=change-refresh-secret

# Email (Mailpit local capture; use resend only with intentionally configured credentials).
EMAIL_PROVIDER=mailpit
RESEND_API_KEY=change-me
EMAIL_FROM=no-reply@gdes.local
MAILPIT_SEND_URL=http://mailpit:8025/api/v1/send
MAILPIT_SEND_API_USER=sender
MAILPIT_SEND_API_PASSWORD=change-send-password
# Separate UI credentials. Set bind address to this host's LAN IP for Android access.
MAILPIT_UI_USER=viewer
MAILPIT_UI_PASSWORD=change-ui-password
MAILPIT_BIND_ADDRESS=127.0.0.1

# WhatsApp (Meta Cloud API). In dev use WHATSAPP_PROVIDER=log.
WHATSAPP_PROVIDER=log
WHATSAPP_TOKEN=change-me
WHATSAPP_PHONE_NUMBER_ID=change-me
# Required only for meta: explicit supported vN.N version and approved AUTHENTICATION template.
WHATSAPP_API_VERSION=
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=

# Storage (Cloudflare R2, S3-compatible)
STORAGE_ENDPOINT=https://example-account.r2.cloudflarestorage.com
STORAGE_BUCKET=gdes-dev
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=change-me
STORAGE_SECRET_ACCESS_KEY=change-me

# Optional signing host, default STORAGE_ENDPOINT. Do not rewrite a signed URL.
# STORAGE_PUBLIC_ENDPOINT=https://downloads.example.com
# HTTP Docker/LAN is opt-in and forbidden outside development/test.
STORAGE_ALLOW_INSECURE_HTTP=false

# Google OAuth
GOOGLE_CLIENT_ID=change-me

# Business rules (defaults from docs/01-arquitectura-y-stack.md)
GEOFENCE_TOLERANCE_METERS=100
OTP_TTL_MINUTES=10

# Apps
API_PUBLIC_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:5173
MOBILE_DEEP_LINK_SCHEME=gdes

# HTTP
PORT=3000
