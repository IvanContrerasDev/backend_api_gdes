// GdeS — initial schema (F-001): User, Site and base enums.
// Source of truth: docs/02-modelo-de-datos.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(uuid()) @db.Uuid
  firstName     String
  lastName      String
  email         String        @unique
  emailVerifiedAt DateTime?
  authSessions AuthSession[]
  authChallenges AuthChallenge[]
  passwordHash  String
  phone         String
  dni           String        @unique
  employeeId    String        @unique
  address       String
  birthDate     DateTime      @db.Date
  siteId        String        @db.Uuid
  site          Site          @relation(fields: [siteId], references: [id])
  cuil          String?
  hireDate      DateTime?     @db.Date
  position      String?
  role          UserRole
  accountStatus AccountStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Site {
  id         String      @id @default(uuid()) @db.Uuid
  name       String      @unique
  users      User[]
  workplaces Workplace[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

// Base enums — central definition (docs/02-modelo-de-datos.md, spec §89).
// Enums without a model yet are used by features F-002+.

enum UserRole {
  EMPLOYEE
  TO_BE_ADMIN
  ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

enum EntityStatus {
  ACTIVE
  INACTIVE
}

enum RecordStatus {
  COMPLETE
  INCOMPLETE
}

enum ReviewStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
  MANUAL_LOADED
}

enum IntervalStatus {
  OPEN
  CLOSED
  SEMI_CLOSED
}

enum IntervalType {
  WORK
  ABSENCE
}

enum IntervalReviewStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum RecordOrigin {
  AUTOMATIC
  MANUAL
}

enum AttendanceEventType {
  CHECK_IN
  CHECK_OUT
  ABSENCE
}

enum EventOrigin {
  MOBILE
  ADMIN
}

enum TimesheetStatus {
  PENDING
  LOADED
  ERROR
}

enum ShapeType {
  CIRCLE
}

enum AbsenceReason {
  ILLNESS
  VACATION
  LEAVE
  ART
  OTHER
}

enum DocumentType {
  DNI
  MEDICAL_CERTIFICATE
  CONTRACT
  ART
  EPP_DOCUMENTATION
  MEDICAL_RECORD
  INTERNAL_RULES
  ADDRESS_DECLARATION
  OTHER
}

enum AuthClient {
  MOBILE
  ADMIN
}

enum OtpPurpose {
  LOGIN
  REGISTER
  GOOGLE_LOGIN
  ADMIN_2FA
}

enum OtpChannel {
  WHATSAPP
  EMAIL
}

enum AdminRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Client {
  id         String       @id @default(uuid()) @db.Uuid
  name       String
  status     EntityStatus @default(ACTIVE)
  workplaces Workplace[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model Workplace {
  id                   String       @id @default(uuid()) @db.Uuid
  clientId             String       @db.Uuid
  client               Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  siteId               String       @db.Uuid
  site                 Site         @relation(fields: [siteId], references: [id], onDelete: Restrict)
  name                 String
  shapeType            ShapeType    @default(CIRCLE)
  latitude             Float
  longitude            Float
  radiusMeters         Int
  gpsAccuracyThreshold Int?
  status               EntityStatus @default(ACTIVE)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([clientId, siteId, status])
}

model AuthSession {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  client AuthClient
  role UserRole
  csrfSecret String
  rememberSession Boolean @default(false)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  refreshTokens AuthRefreshToken[]
  @@index([userId])
}
model AuthRefreshToken {
  hash String @id
  sessionId String @db.Uuid
  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  generation Int
  expiresAt DateTime
  usedAt DateTime?
  @@unique([sessionId, generation])
}
model AuthChallenge {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  client AuthClient
  purpose OtpPurpose
  codeHash String
  preauthHash String?
  rememberSession Boolean @default(false)
  attempts Int @default(0)
  expiresAt DateTime
  sentAt DateTime @default(now())
  consumedAt DateTime?
  @@index([userId, client])
}
model AuthRateLimit {
  key String @id
  count Int
  resetsAt DateTime
}
