// GdeS — initial schema (F-001): User, Site and base enums.
// Source of truth: docs/02-modelo-de-datos.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(uuid()) @db.Uuid
  firstName     String
  lastName      String
  email         String        @unique
  emailVerifiedAt DateTime?
  documents Document[] @relation("DocumentEmployee")
  uploadedDocuments Document[] @relation("DocumentUploader")
  timesheets Timesheet[] @relation("TimesheetEmployee")
  uploadedTimesheets Timesheet[] @relation("TimesheetUploader")
  replacedTimesheets Timesheet[] @relation("TimesheetReplacer")
  monthlySnapshots MonthlySnapshot[]
  attendanceEvents AttendanceEvent[]
  attendanceRecords AttendanceRecord[]
  authSessions AuthSession[]
  authChallenges AuthChallenge[]
  passwordHash  String
  phone         String
  dni           String        @unique
  employeeId    String        @unique
  address       String
  birthDate     DateTime      @db.Date
  siteId        String        @db.Uuid
  site          Site          @relation(fields: [siteId], references: [id])
  cuil          String?
  hireDate      DateTime?     @db.Date
  position      String?
  role          UserRole
  accountStatus AccountStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Site {
  id         String      @id @default(uuid()) @db.Uuid
  name       String      @unique
  users      User[]
  attendanceRecords AttendanceRecord[]
  workplaces Workplace[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

// Base enums — central definition (docs/02-modelo-de-datos.md, spec §89).
// Enums without a model yet are used by features F-002+.

enum UserRole {
  EMPLOYEE
  TO_BE_ADMIN
  ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

enum EntityStatus {
  ACTIVE
  INACTIVE
}

enum RecordStatus {
  COMPLETE
  INCOMPLETE
}

enum ReviewStatus {
  NONE
  PENDING
  APPROVED
  MANUAL_LOADED
}

enum IntervalStatus {
  OPEN
  CLOSED
  SEMI_CLOSED
}

enum IntervalType {
  WORK
  ABSENCE
}

enum IntervalReviewStatus {
  NONE
  PENDING
  APPROVED
}

enum RecordOrigin {
  AUTOMATIC
  MANUAL
}

enum AttendanceEventType {
  CHECK_IN
  CHECK_OUT
  ABSENCE
}

enum EventOrigin {
  MOBILE
  ADMIN
}

enum TimesheetStatus {
  PENDING
  LOADED
  ERROR
}

enum ShapeType {
  CIRCLE
}

enum AbsenceReason {
  ILLNESS
  VACATION
  LEAVE
  ART
  OTHER
}

enum DocumentType {
  DNI
  MEDICAL_CERTIFICATE
  CONTRACT
  ART
  EPP_DOCUMENTATION
  MEDICAL_RECORD
  INTERNAL_RULES
  ADDRESS_DECLARATION
  OTHER
}

enum AuthClient {
  MOBILE
  ADMIN
}

enum OtpPurpose {
  LOGIN
  REGISTER
  GOOGLE_LOGIN
  ADMIN_2FA
}

enum OtpChannel {
  WHATSAPP
  EMAIL
}

enum AdminRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Client {
  id         String       @id @default(uuid()) @db.Uuid
  name       String
  status     EntityStatus @default(ACTIVE)
  workplaces Workplace[]
  attendanceRecords AttendanceRecord[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model Workplace {
  id                   String       @id @default(uuid()) @db.Uuid
  clientId             String       @db.Uuid
  client               Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  siteId               String       @db.Uuid
  site                 Site         @relation(fields: [siteId], references: [id], onDelete: Restrict)
  name                 String
  shapeType            ShapeType    @default(CIRCLE)
  latitude             Float
  longitude            Float
  radiusMeters         Int
  gpsAccuracyThreshold Int?
  status               EntityStatus @default(ACTIVE)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  attendanceEvents AttendanceEvent[]
  attendanceRecords AttendanceRecord[]
  timesheets Timesheet[]
  documents Document[]

  @@index([clientId, siteId, status])
}

model AuthSession {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  client AuthClient
  role UserRole
  csrfSecret String
  rememberSession Boolean @default(false)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  refreshTokens AuthRefreshToken[]
  @@index([userId])
}
model AuthRefreshToken {
  hash String @id
  sessionId String @db.Uuid
  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  generation Int
  expiresAt DateTime
  usedAt DateTime?
  @@unique([sessionId, generation])
}
model AuthChallenge {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  client AuthClient
  purpose OtpPurpose
  codeHash String
  preauthHash String?
  rememberSession Boolean @default(false)
  attempts Int @default(0)
  expiresAt DateTime
  sentAt DateTime @default(now())
  consumedAt DateTime?
  @@index([userId, client])
}
model AuthRateLimit {
  key String @id
  count Int
  resetsAt DateTime
}

// Receipt/projection order is serialized by User. Interval.sequence records that
// order explicitly; client timestamps and database timestamp ties never reorder it.
model AttendanceEvent {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  workplaceId String @db.Uuid
  workplace Workplace @relation(fields: [workplaceId], references: [id], onDelete: Restrict)
  recordId String @db.Uuid
  record AttendanceRecord @relation(fields: [recordId], references: [id], onDelete: Restrict)
  type AttendanceEventType
  occurredAt DateTime
  receivedAt DateTime
  clientSentAt DateTime?
  latitude Float
  longitude Float
  accuracy Float
  locationTimestamp DateTime
  observation String?
  absenceReason AbsenceReason?
  clientRequestId String @unique
  origin EventOrigin
  deviceInfo Json?
  responseMessage String
  entries Interval[] @relation("EntryEvent")
  exits Interval[] @relation("ExitEvent")
  absences Interval[] @relation("AbsenceEvent")
  createdAt DateTime @default(now())
  // Append-only: no updatedAt; no write API other than insertion.
  @@index([userId, receivedAt])
  @@index([recordId])
}
model AttendanceRecord {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  workplaceId String @db.Uuid
  workplace Workplace @relation(fields: [workplaceId], references: [id], onDelete: Restrict)
  // Historical snapshots, never updated when Workplace is reassigned.
  clientId String @db.Uuid
  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  siteId String @db.Uuid
  site Site @relation(fields: [siteId], references: [id], onDelete: Restrict)
  date DateTime @db.Date
  totalWorkMinutes Int @default(0)
  recordStatus RecordStatus
  reviewStatus ReviewStatus @default(NONE)
  origin RecordOrigin
  observations String?
  version Int @default(1)
  events AttendanceEvent[]
  intervals Interval[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, workplaceId, date])
  @@index([userId, date])
  @@index([date, userId, workplaceId])
  @@index([workplaceId])
}
model Interval {
  id String @id @default(uuid()) @db.Uuid
  recordId String @db.Uuid
  record AttendanceRecord @relation(fields: [recordId], references: [id], onDelete: Restrict)
  sequence Int
  type IntervalType
  startTime DateTime?
  endTime DateTime?
  intervalStatus IntervalStatus
  reviewStatus IntervalReviewStatus @default(NONE)
  origin RecordOrigin
  absenceReason AbsenceReason?
  observations String?
  entryEventId String? @db.Uuid
  entryEvent AttendanceEvent? @relation("EntryEvent", fields: [entryEventId], references: [id], onDelete: Restrict)
  exitEventId String? @db.Uuid
  exitEvent AttendanceEvent? @relation("ExitEvent", fields: [exitEventId], references: [id], onDelete: Restrict)
  absenceEventId String? @db.Uuid
  absenceEvent AttendanceEvent? @relation("AbsenceEvent", fields: [absenceEventId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([recordId, sequence])
  @@index([entryEventId])
  @@index([exitEventId])
  @@index([absenceEventId])
}

// Technical immutable monthly read snapshot. Expiry is absolute, never renewed.
model MonthlySnapshot {
  id String @id @default(uuid()) @db.Uuid
  ownerId String @db.Uuid
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  context String
  payload Json
  createdAt DateTime @default(now())
  expiresAt DateTime
  @@index([expiresAt])
  @@index([ownerId])
}

// Shared document-domain persistence. Dashboard reads period/status; F-007 owns uploads.
model Timesheet {
  id String @id @default(uuid()) @db.Uuid
  employeeId String @db.Uuid
  employee User @relation("TimesheetEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  workplaceId String @db.Uuid
  workplace Workplace @relation(fields: [workplaceId], references: [id], onDelete: Restrict)
  month Int
  year Int
  sequenceNumber Int
  status TimesheetStatus @default(PENDING)
  fileKey String @unique
  fileName String
  fileExtension String
  fileSizeBytes Int
  contentType String @default("application/octet-stream")
  uploadedById String @db.Uuid
  uploadedBy User @relation("TimesheetUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  replacedById String? @db.Uuid
  replacedBy User? @relation("TimesheetReplacer", fields: [replacedById], references: [id], onDelete: Restrict)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([employeeId, workplaceId, month, year, sequenceNumber])
  @@index([year, month, status])
  @@index([workplaceId])
}

model Document {
  id String @id @default(uuid()) @db.Uuid
  employeeId String @db.Uuid
  employee User @relation("DocumentEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  workplaceId String? @db.Uuid
  workplace Workplace? @relation(fields: [workplaceId], references: [id], onDelete: Restrict)
  type DocumentType
  fileKey String @unique
  fileName String
  fileExtension String
  fileSizeBytes Int
  contentType String
  uploadedById String @db.Uuid
  uploadedBy User @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([employeeId, createdAt])
  @@index([uploadedById])
  @@index([workplaceId])
  @@index([createdAt, id])
}

// A pre-upload journal also recovers abandoned or ambiguously committed objects.
// Publication and cleanup serialize on this row; immutable keys are never reused.
model StorageCleanupJob {
  id String @id @default(uuid()) @db.Uuid
  key String @unique
  namespace String @default("")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([namespace, nextAttemptAt])
}
